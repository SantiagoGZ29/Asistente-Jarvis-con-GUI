# ============================================================
# Mi Jarvis - configuración de ejemplo
# Copia este archivo como ".env" y rellena tus claves.
# NUNCA subas el archivo .env a un repositorio.
# ============================================================

# ---------- Google Gemini (obligatorio para preguntas y resúmenes) ----------
GEMINI_API_KEY=
# Modelo verificado en este proyecto. Si devuelve 503 por alta demanda,
# prueba otro modelo gratuito disponible en tu cuenta.
GEMINI_MODEL=gemini-3.6-flash

# ---------- ElevenLabs (opcional; sin estas claves Jarvis funciona en modo texto) ----------
ELEVENLABS_API_KEY=
# En el plan gratuito usa una voz "premade" de tu cuenta; las voces de
# biblioteca o "professional" devuelven 402 al usarse por API.
ELEVENLABS_VOICE_ID=
# Transcripción por lotes (respaldo y modo batch)
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Transcripción en tiempo real (Scribe Realtime v2)
ELEVENLABS_REALTIME_MODEL_ID=scribe_v2_realtime
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_LANGUAGE_CODE=es

# ---------- Comportamiento del asistente (opcional) ----------
# Máximo de caracteres de documento enviados a Gemini por consulta
JARVIS_MAX_CONTEXT_CHARS=12000
# Máximo de caracteres por lote al resumir documentos largos
JARVIS_MAX_CHUNK_BATCH_CHARS=9000
# Tamaño objetivo de cada fragmento del documento
JARVIS_CHUNK_SIZE_CHARS=1200
# Segundos máximos de una grabación de micrófono (modo consola)
JARVIS_MAX_RECORD_SECONDS=60
# Frecuencia de muestreo de la captura de audio
JARVIS_SAMPLE_RATE=16000
# Mostrar la respuesta también en voz alta cuando la voz está configurada (true/false)
JARVIS_SPEAK_RESPONSES=true
# Nivel de registro técnico: DEBUG, INFO, WARNING, ERROR
JARVIS_LOG_LEVEL=INFO

# ---------- Conversación por voz (opcional) ----------
# realtime: Scribe Realtime v2 con fallback automático a lotes
# batch: solo transcripción por lotes al terminar cada frase
JARVIS_STT_MODE=realtime
# Activar la escucha al arrancar (siempre requiere consentimiento)
JARVIS_AUTO_LISTEN=true
# Micrófono recordado. Formato: "Host API|Nombre|índice" o vacío para el predeterminado
JARVIS_INPUT_DEVICE=
# Detección de voz local: margen sobre el ruido de fondo y nivel mínimo
JARVIS_VAD_MARGIN_DB=9
JARVIS_VAD_MIN_RMS=120
# Silencio que cierra un turno (milisegundos)
JARVIS_SILENCE_MS=850
# Audio previo al inicio de la voz que se conserva (milisegundos)
JARVIS_PREROLL_MS=300
# Duración mínima de voz para considerar una frase (milisegundos)
JARVIS_MIN_SPEECH_MS=250
# Saludo inicial (se muestra siempre; se habla si la voz está configurada)
JARVIS_GREETING=Hola. Soy Jarvis y estoy listo para ayudarte. Puedes pedirme que abra un documento, que lo resuma o que te explique su contenido.

# ---------- Búsqueda de documentos en Descargas (opcional) ----------
# Profundidad máxima de subcarpetas dentro de Descargas
JARVIS_DOWNLOADS_MAX_DEPTH=3
# Número máximo de archivos revisados por búsqueda
JARVIS_DOWNLOADS_MAX_FILES=2000
